<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<!--
    PARALLEL EXECUTION suite.
    Run with: mvn test -DsuiteXmlFile=src/test/resources/testng-parallel.xml

    parallel="classes" - each test class runs in its own thread.
    thread-count="4"   - up to 4 threads at once.

    Other options:
    - parallel="methods"   - methods within a class run in parallel
    - parallel="tests"     - each <test> tag runs in parallel
    - parallel="instances" - instances (from @Factory) in parallel
-->

<suite name="Parallel Suite" parallel="methods" thread-count="4" verbose="1">

    <test name="All Parallel Tests">
        <classes>
            <class name="it.academy.T11_ParallelTest"/>
            <class name="it.academy.T01_BasicAnnotationsTest"/>
        </classes>
    </test>


</suite>

